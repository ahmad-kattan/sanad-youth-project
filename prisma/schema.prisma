// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  ADMIN
  SUPERVISOR
  STUDENT
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  supervisedPrograms Program[]      @relation("ProgramSupervisor")
  applications       Application[]
  announcements      Announcement[] @relation("AnnouncementAuthor")
}

model Session {
  id               Int      @id @default(autoincrement())
  userId           Int
  refreshTokenHash String
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Program {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  imageUrl       String?
  capacity       Int
  availableSeats Int
  supervisorId   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supervisor User @relation("ProgramSupervisor",fields: [supervisorId],references: [id],onDelete: Restrict)

  applications  Application[]
  sessions      ProgramSession[]
  materials     ProgramMaterial[]
  announcements Announcement[]
}

model Application {
  id        Int               @id @default(autoincrement())
  studentId Int
  programId Int
  status    ApplicationStatus @default(PENDING)
  cvUrl     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  student User @relation(fields: [studentId],references: [id],onDelete: Restrict)

  program Program @relation(fields: [programId],references: [id],onDelete: Restrict)

  @@unique([studentId, programId])
  @@index([studentId, status])
  @@index([programId, status])
}

model ProgramSession {
  id         Int      @id @default(autoincrement())
  programId  Int
  title      String
  startsAt   DateTime
  endsAt     DateTime
  location   String?
  meetingUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  program Program @relation(fields: [programId],references: [id],onDelete: Cascade)

  @@index([programId, startsAt])
}

model ProgramMaterial {
  id          Int      @id @default(autoincrement())
  programId   Int
  title       String
  description String?
  fileUrl     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program Program @relation(fields: [programId],references: [id],onDelete: Cascade)

  @@index([programId])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  authorId    Int
  programId   Int?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation("AnnouncementAuthor",fields: [authorId],references: [id],onDelete: Restrict)

  program Program? @relation(fields: [programId],references: [id],onDelete: Cascade)

  @@index([programId, isPublished])
  @@index([isPublished, publishedAt])
}
